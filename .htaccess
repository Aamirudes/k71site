<IfModule mod_rewrite.c>
    RewriteEngine On

    # Disable directory indexing
    Options -Indexes

    # Block access to hidden and sensitive files
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package\.(json|lock)|artisan|phpunit\.xml) - [F,L,NC]

    # Block direct access to internal Laravel directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage/app|storage/logs|tests|docs|legacy)(/.*)?$ - [F,L,NC]

    # Block direct access to composer vendor sensitive files without blocking Laravel /vendor/ routes
    RewriteRule ^vendor/(autoload\.php|composer/|bin/|.*\.json|.*\.lock|.*\.md) - [F,L,NC]

    # Allow direct access if the file exists in root (e.g. deploy.php)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Rewrite everything else to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_security.c>
    SecFilterEngine Off
    SecFilterScanPOST Off
</IfModule>
<IfModule mod_security2.c>
    SecRuleEngine Off
</IfModule>
